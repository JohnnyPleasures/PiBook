#!/bin/sh
set -eu

STATE_DIR="/var/lib/pibook-boot-guard"
ARMED="$STATE_DIR/armed"
ROLLBACK="$STATE_DIR/rollback.sh"

log()
{
    msg="$*"

    echo "PiBook Boot Guard: $msg"
    logger -t pibook-boot-guard -- "$msg" 2>/dev/null || true

    install -d -m 700 "$STATE_DIR"

    printf '%s boot=%s %s\n' \
        "$(date --iso-8601=seconds)" \
        "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)" \
        "$msg" \
        >> "$STATE_DIR/history.log" 2>/dev/null || true

    chmod 600 "$STATE_DIR/history.log" 2>/dev/null || true
}

health_ok()
{
    if ! systemctl is-active --quiet pibook-zero.service; then
        log "HEALTH FAIL: pibook-zero.service inactive"
        return 1
    fi

    if ! journalctl -b \
        -u pibook-zero.service \
        --no-pager |
        grep -Fq 'Physical UI ready'
    then
        log "HEALTH FAIL: Physical UI ready ausente"
        return 1
    fi

    if ! journalctl -b \
        -u pibook-zero.service \
        --no-pager |
        grep -Fq 'Web server started on port 5000'
    then
        log "HEALTH FAIL: web server marker ausente"
        return 1
    fi

    if ! ip -4 -o addr show dev wlan0 2>/dev/null |
        grep -q ' inet '
    then
        log "HEALTH FAIL: wlan0 sem IPv4"
        return 1
    fi

    if ! /home/pi/PiBook/.venv/bin/python -c \
        'import socket; s=socket.create_connection(("127.0.0.1",5000),3); s.close()' \
        >/dev/null 2>&1
    then
        log "HEALTH FAIL: socket 127.0.0.1:5000 inacessivel"
        return 1
    fi

    return 0
}

cmd="${1:-status}"

case "$cmd" in
    status)
        if [ -e "$ARMED" ]; then
            echo "ARMED"
            cat "$ARMED"
            [ -f "$ROLLBACK" ] &&
                echo "rollback_script=present" ||
                echo "rollback_script=MISSING"
        else
            echo "DISARMED"
        fi
        ;;

    arm)
        script="${2:-}"

        if [ -z "$script" ] || [ ! -f "$script" ]; then
            echo "Uso: pibook-boot-guard arm /caminho/rollback.sh" >&2
            exit 2
        fi

        install -d -m 700 "$STATE_DIR"
        install -m 700 "$script" "$ROLLBACK"

        {
            echo "armed_at=$(date --iso-8601=seconds)"
            echo "armed_boot_id=$(cat /proc/sys/kernel/random/boot_id)"
        } > "$ARMED"

        chmod 600 "$ARMED"
        sync

        log "ARMED — rollback automático no próximo boot."
        ;;

    disarm)
        rm -f "$ARMED" "$ROLLBACK"
        sync
        log "DISARMED."
        ;;

    check)
        if [ ! -e "$ARMED" ]; then
            log "Não armado; nenhuma ação."
            exit 0
        fi

        if health_ok; then
            log "Boot saudável: UI + rede + web confirmados."
            rm -f "$ARMED" "$ROLLBACK"
            sync
            log "Rollback automaticamente cancelado."
            exit 0
        fi

        log "FALHA DE SAÚDE — iniciar rollback."

        # Preserve diagnostics before reboot. Journald is volatile on PiBook,
        # so without this dump the traceback would disappear after rollback.
        {
            echo "=== PIBOOK BOOT GUARD FAILURE ==="
            echo "timestamp=$(date --iso-8601=seconds)"
            echo "boot_id=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)"
            echo
            echo "=== pibook-zero.service status ==="
            systemctl status pibook-zero.service --no-pager -l || true
            echo
            echo "=== pibook-zero journal ==="
            journalctl -b -u pibook-zero.service --no-pager -o short-monotonic || true
            echo
            echo "=== kernel GPIO/SPI ==="
            journalctl -b --no-pager -o short-monotonic |
                grep -Ei 'gpio|gpiomem|gpiochip|spi|spidev' || true
        } > "$STATE_DIR/last-failed-boot.log" 2>&1

        chmod 600 "$STATE_DIR/last-failed-boot.log" 2>/dev/null || true
        sync

        log "Diagnóstico da falha guardado em last-failed-boot.log."

        if [ ! -s "$ROLLBACK" ]; then
            log "ERRO: rollback armado mas script está ausente."
            exit 1
        fi

        if /bin/sh "$ROLLBACK"; then
            log "Rollback executado com sucesso."
            rm -f "$ARMED" "$ROLLBACK"
            sync

            log "Reiniciar para versão conhecida como boa."
            systemctl reboot
        else
            rc=$?
            log "ERRO: rollback falhou (rc=$rc). NÃO reiniciar."
            exit "$rc"
        fi
        ;;

    *)
        echo "Uso: pibook-boot-guard {status|arm|disarm|check}" >&2
        exit 2
        ;;
esac
