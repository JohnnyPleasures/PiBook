#!/usr/bin/env python3
"""Servidor HTTP mínimo do portal cativo PiBook.

Qualquer pedido HTTP recebido na porta 80 é redirecionado para a página
normal do servidor PiBook, que continua a funcionar na porta 5000.
"""

from __future__ import annotations

import argparse
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import logging
import sys
from urllib.parse import urlparse


LOGGER = logging.getLogger("pibook-captive-portal")


class RedirectHandler(BaseHTTPRequestHandler):
    server_version = "PiBookCaptivePortal/1.0"
    sys_version = ""
    protocol_version = "HTTP/1.1"

    def _redirect(self, status: HTTPStatus) -> None:
        target = str(self.server.target_url)
        body = (
            "<!doctype html><html lang='pt'><head>"
            "<meta charset='utf-8'>"
            "<meta name='viewport' "
            "content='width=device-width,initial-scale=1'>"
            f"<meta http-equiv='refresh' content='0;url={target}'>"
            "<title>PiBook</title></head><body>"
            f"<p>A abrir o <a href='{target}'>PiBook</a>…</p>"
            "</body></html>"
        ).encode("utf-8")

        self.send_response(status)
        self.send_header("Location", target)
        self.send_header(
            "Cache-Control",
            "no-store, no-cache, must-revalidate, max-age=0",
        )
        self.send_header("Pragma", "no-cache")
        self.send_header("Expires", "0")
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Connection", "close")
        self.end_headers()

        if self.command != "HEAD":
            self.wfile.write(body)

        self.close_connection = True

    def do_GET(self) -> None:
        self._redirect(HTTPStatus.FOUND)

    def do_HEAD(self) -> None:
        self._redirect(HTTPStatus.FOUND)

    def do_POST(self) -> None:
        self._discard_request_body()
        self._redirect(HTTPStatus.SEE_OTHER)

    def do_PUT(self) -> None:
        self._discard_request_body()
        self._redirect(HTTPStatus.SEE_OTHER)

    def do_DELETE(self) -> None:
        self._redirect(HTTPStatus.SEE_OTHER)

    def do_OPTIONS(self) -> None:
        self.send_response(HTTPStatus.NO_CONTENT)
        self.send_header("Allow", "GET, HEAD, POST, PUT, DELETE, OPTIONS")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True

    def _discard_request_body(self) -> None:
        length_text = self.headers.get("Content-Length", "0")
        try:
            length = min(max(int(length_text), 0), 1024 * 1024)
        except ValueError:
            length = 0

        if length:
            self.rfile.read(length)

    def log_message(self, format_string: str, *args: object) -> None:
        LOGGER.info(
            "%s %s — " + format_string,
            self.client_address[0],
            self.path,
            *args,
        )


class PortalServer(ThreadingHTTPServer):
    allow_reuse_address = True
    daemon_threads = True

    def __init__(
        self,
        server_address: tuple[str, int],
        handler_class: type[BaseHTTPRequestHandler],
        target_url: str,
    ) -> None:
        self.target_url = target_url
        super().__init__(server_address, handler_class)


def valid_target(value: str) -> str:
    parsed = urlparse(value)

    if parsed.scheme != "http":
        raise argparse.ArgumentTypeError(
            "O destino deve usar http://."
        )

    if parsed.hostname != "10.42.0.1":
        raise argparse.ArgumentTypeError(
            "O destino deve apontar para 10.42.0.1."
        )

    if parsed.port != 5000:
        raise argparse.ArgumentTypeError(
            "O destino deve usar a porta 5000."
        )

    return value


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Portal cativo HTTP do PiBook"
    )
    parser.add_argument(
        "--listen",
        default="0.0.0.0",
    )
    parser.add_argument(
        "--port",
        type=int,
        default=80,
    )
    parser.add_argument(
        "--target",
        type=valid_target,
        default="http://10.42.0.1:5000/",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="Validar os argumentos sem iniciar o servidor",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()

    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
    )

    if args.port < 1 or args.port > 65535:
        print("ERRO: porta inválida.", file=sys.stderr)
        return 2

    if args.check:
        print(
            f"Configuração válida: "
            f"{args.listen}:{args.port} -> {args.target}"
        )
        return 0

    server = PortalServer(
        (args.listen, args.port),
        RedirectHandler,
        args.target,
    )

    LOGGER.info(
        "Portal cativo ativo em %s:%s -> %s",
        args.listen,
        args.port,
        args.target,
    )

    try:
        server.serve_forever(poll_interval=0.5)
    except KeyboardInterrupt:
        LOGGER.info("Interrupção manual recebida")
    finally:
        server.server_close()
        LOGGER.info("Portal cativo terminado")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
